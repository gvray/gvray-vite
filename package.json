{
  "name": "gvray-vite",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start:dev": "tsx scripts/dev.ts --mode dev --port 9527 --mock true",
    "start:staging": "tsx scripts/dev.ts --mode staging --port 9528",
    "start:prod": "tsx scripts/dev.ts --mode prod --port 9529",
    "build": "tsc -b && vite build --mode prod",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:prod": "tsc -b && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "tsx scripts/gen-api-types.ts",
    "docker:build": "tsx scripts/docker-build.ts",
    "docker:build:multiarch": "tsx scripts/docker-build.ts -m",
    "docker:build:scan": "tsx scripts/docker-build.ts -s",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "docker:compose:up": "docker-compose up -d",
    "docker:deploy": "tsx scripts/docker-deploy.ts",
    "docker:logs": "docker logs -f gvray-vite-web",
    "docker:run": "docker run -d --name gvray-vite-web -p 8080:80 gvray/gvray-vite:latest",
    "docker:stop": "docker stop gvray-vite-web && docker rm gvray-vite-web"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@gvray/adminkit": "^1.2.0",
    "@gvray/colorkit": "^1.2.0",
    "@gvray/datekit": "^1.2.0",
    "@gvray/domkit": "^1.2.0",
    "@gvray/eskit": "^1.4.0",
    "@gvray/formatkit": "^1.2.0",
    "@gvray/logger": "^1.1.0",
    "@gvray/mathkit": "^1.2.0",
    "@gvray/pathkit": "^1.2.0",
    "@gvray/request": "^1.2.0",
    "@gvray/requestkit": "^1.2.0",
    "@gvray/validationkit": "^1.1.0",
    "antd": "^6.6.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.35.0",
    "nprogress": "^0.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-intl": "^10.1.24",
    "react-router": "^8.3.1",
    "storetify": "^1.7.0",
    "styled-components": "^6.1.17",
    "use-compare": "^1.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/crypto-js": "^4.2.2",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.13.3",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "minimist": "^1.2.8",
    "sass": "^1.88.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-mock": "^3.0.2"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "packageManager": "pnpm@9.15.9"
}
